// Prisma schema — Sistem Management Input & Laporan Penjualan Shopee Multi-Toko
// Database: PostgreSQL (lokal via service Windows / Docker, produksi via Supabase/Neon/Vercel Postgres).
// DATABASE_URL diisi di .env — lihat README.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime: pakai endpoint POOLED Neon (host ...-pooler...) + ?pgbouncer=true
  url       = env("DATABASE_URL")
  // Migrasi/introspeksi: endpoint LANGSUNG Neon (tanpa -pooler). Lokal = sama dgn DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN_TOKO
}

enum OrderStatus {
  CANCEL
  RETUR
  TRANSIT
  PENDING_SETTLEMENT
  SELESAI
}

enum ReturCondition {
  GOOD
  DAMAGED
}

model User {
  id            String            @id @default(cuid())
  name          String
  email         String            @unique
  passwordHash  String
  role          Role
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  storeAccess   UserStore[]
  uploadLogs    UploadLog[]
  priceChanges  ProductPriceLog[]

  @@map("users")
}

model Store {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  admins    UserStore[]
  orders    Order[]
  uploads   UploadLog[]

  @@map("stores")
}

model UserStore {
  id      String @id @default(cuid())
  userId  String
  storeId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@map("user_stores")
}

// Master produk GLOBAL — 1 SKU = 1 HPP + 1 harga katalog, berlaku untuk semua toko.
// Hanya OWNER yang boleh mengubah master ini (lihat api/products).
model Product {
  id           String            @id @default(cuid())
  sku          String            @unique
  name         String
  hpp          Float // HPP / Modal per unit
  catalogPrice Float // Harga katalog agen (sebelum diskon 50%)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  orders       Order[]
  priceLogs    ProductPriceLog[]

  @@map("products")
}

// Audit log: dicatat tiap kali HPP dan/atau Harga Katalog sebuah produk berubah.
model ProductPriceLog {
  id           String   @id @default(cuid())
  productId    String
  sku          String
  name         String
  oldHpp       Float
  newHpp       Float
  oldCatalog   Float
  newCatalog   Float
  source       String   @default("manual") // "manual" | "import"
  changedById  String
  changedBy    User     @relation(fields: [changedById], references: [id])
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([productId, createdAt])
  @@map("product_price_logs")
}

model UploadLog {
  id          String   @id @default(cuid())
  storeId     String
  adminUserId String
  fileName    String
  totalRows   Int
  successRows Int
  failedRows  Int
  errorLog    String? // JSON string ringkasan error per baris
  createdAt   DateTime @default(now())
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  admin       User     @relation(fields: [adminUserId], references: [id])
  orders      Order[]

  @@map("upload_logs")
}

model Order {
  id                 String          @id @default(cuid())
  storeId            String
  productId          String?
  uploadLogId        String
  orderSn            String // No. Pesanan Shopee
  sku                String
  productName        String
  qty                Int
  orderCreatedAt      DateTime // Tanggal Pesanan Dibuat (dari file Shopee)
  status             OrderStatus
  returCondition     ReturCondition?
  grossOmzet         Float           @default(0) // Omzet bruto (0 kalau cancel)
  netSettlement      Float           @default(0) // Uang cair dari Shopee (setelah biaya admin)
  adminFee           Float           @default(0)
  hppSnapshot        Float           @default(0) // HPP saat transaksi (snapshot dari master)
  catalogPriceSnapshot Float         @default(0) // Harga katalog saat transaksi
  profitHpp          Float           @default(0) // netSettlement - hppSnapshot (khusus SELESAI)
  profitAgen         Float           @default(0) // (catalogPrice*0.5) - hppSnapshot
  periodKey          String // Label periode cut-off, format YYYY-MM-DD_YYYY-MM-DD (26 s/d 25)
  rawRow             String? // JSON string baris asli untuk audit/debug
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id])
  uploadLog UploadLog @relation(fields: [uploadLogId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@index([storeId, periodKey])
  @@index([orderSn])
  @@map("orders")
}

model PeriodSetting {
  id        String   @id @default(cuid())
  cutoffDay Int      @default(25)
  updatedAt DateTime @updatedAt

  @@map("period_settings")
}

// Aturan klasifikasi: teks "Status Pesanan" dari file Shopee -> kategori internal.
// Dicocokkan sebagai substring (case-insensitive). Bila beberapa pattern cocok,
// yang priority paling kecil menang. Bisa diedit lewat /settings/status-mapping
// tanpa perlu deploy ulang. Fallback default ada di src/lib/classification.ts.
model StatusMapping {
  id        String      @id @default(cuid())
  pattern   String      @unique
  category  OrderStatus
  priority  Int         @default(100)
  note      String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("status_mappings")
}

model PeriodLock {
  id        String   @id @default(cuid())
  periodKey String   @unique
  locked    Boolean  @default(true)
  lockedAt  DateTime @default(now())
  lockedBy  String?

  @@map("period_locks")
}
