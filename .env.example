# ============================================================================
# LOKAL (portable PostgreSQL via `npm run db:setup`) — dua URL sama:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopee_multi_store?schema=public"
#   DIRECT_URL="postgresql://postgres:postgres@localhost:5432/shopee_multi_store?schema=public"
#
# PRODUKSI (Neon + Vercel):
#   DATABASE_URL = connection string POOLED  (host mengandung "-pooler"), tambah &pgbouncer=true
#   DIRECT_URL   = connection string LANGSUNG (host tanpa "-pooler")     -> dipakai prisma migrate
# ============================================================================
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# NextAuth
# Secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="ganti-dengan-random-string-panjang"
# Lokal: http://localhost:3000  |  Produksi: https://<nama-project>.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# (opsional) Ambang notifikasi "uang mengambang" di lonceng topbar. Default 5.000.000.
# ALERT_MENGAMBANG_THRESHOLD="5000000"
