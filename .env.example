# Database — PostgreSQL
# Lokal (contoh): user "postgres", password "postgres", DB "shopee_multi_store" di port 5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopee_multi_store?schema=public"
# Produksi (Supabase / Neon / Vercel Postgres) — pakai connection string dari provider,
# biasanya perlu ?sslmode=require dan (untuk serverless) pooler/transaction mode.
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth
# Generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="ganti-dengan-random-string-panjang"
NEXTAUTH_URL="http://localhost:3000"
